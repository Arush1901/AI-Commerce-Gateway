# ─────────────────────────────────────────────────────────────
# AI-Commerce-Gateway — server environment
# Copy this file to `.env` and fill in real values.
#   cp .env.example .env
# The .env file is git-ignored and must never be committed.
# ─────────────────────────────────────────────────────────────

# ── Groq LLM (intent extraction) ─────────────────────────────
# Required. Get a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Optional overrides (sensible defaults are used if omitted):
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# ── Razorpay (payment order creation) ────────────────────────
# Required to take payment. Use TEST keys for development:
#   https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# ── Signed spend mandate ─────────────────────────────────────
# Secret used to HMAC-sign the agent's spending mandate.
# Set to a long random string in production. A demo default is
# used if this is omitted.
MANDATE_SECRET=change_me_to_a_long_random_string

# ── Server ───────────────────────────────────────────────────
# Port the Express API listens on (defaults to 3001).
PORT=3001
